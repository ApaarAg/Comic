# Storyverse 4.0 Environment Variables Configuration Template
# Copy this file to .env and configure the values for your deployment.

# GEMINI_API_KEY: Optional - Server-side Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# ELEVENLABS_API_KEY: Optional - Offline voice synthesis scripts (never exposed to client).
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# Server Port
PORT=3000
